# Passerelle de génération : fake (défaut) ou http
GENERATION_GATEWAY_MODE=fake

# Mode http : API de génération externe
GENERATION_API_BASE_URL=
GENERATION_API_KEY=
GENERATION_API_AUTH_HEADER=Authorization
GENERATION_API_AUTH_SCHEME=Bearer
GENERATION_CONNECT_TIMEOUT=10
GENERATION_READ_TIMEOUT=600
GENERATION_POLL_INTERVAL=2
GENERATION_MAX_TRACK_SECONDS=600

# Origines de confiance pour le téléchargement des médias (séparées par des virgules)
TRUSTED_MEDIA_ORIGINS=
